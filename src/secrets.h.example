// Copy to src/secrets.h and fill in. The file is gitignored, and the panel
// runs offline with only its own access point when it is absent. Each define is
// guarded so a -D build flag (tools/onboard.sh, tools/publish_fw.sh) wins.
#ifndef PXT_RELAY_HOST
#define PXT_RELAY_HOST "relay.example.com"
#endif
#ifndef PXT_RELAY_PORT
#define PXT_RELAY_PORT 443
#endif
#ifndef PXT_RELAY_KEY
#define PXT_RELAY_KEY "change-me-to-a-long-random-string"
#endif
